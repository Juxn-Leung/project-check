{
  "name": "project-check-skill",
  "version": "0.2.0",
  "description": "Codex skill for evidence-based project acceptance tests, with a local skill installer.",
  "type": "module",
  "bin": {
    "project-check": "bin/project-check.js"
  },
  "files": [
    "bin/project-check.js",
    "SKILL.md",
    "agents/openai.yaml",
    "assets/*.json",
    "assets/playwright/*",
    "references/*.md",
    "scripts/project_check.py",
    "scripts/report_adapters.py"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -v",
    "prepublishOnly": "npm test && npm run test:python"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juxn-Leung/project-check.git"
  },
  "bugs": {
    "url": "https://github.com/Juxn-Leung/project-check/issues"
  },
  "homepage": "https://github.com/Juxn-Leung/project-check#readme",
  "keywords": [
    "codex",
    "skill",
    "testing",
    "acceptance-testing",
    "frontend"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
